# Copy to .env and fill in. Never commit .env.
# At least ONE provider key is required.

# Gemini Live API (default provider) — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenAI Realtime API — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Single-household password gate (choose something simple but not trivial)
APP_PASSWORD=changeme

# Session log location (volume-mounted)
DATA_DIR=/data
